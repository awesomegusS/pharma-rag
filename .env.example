# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model paths & settings ────────────────────────────────────────────────────
MISTRAL_PATH=./models/mistral.gguf
MISTRAL_N_CTX=16384
MISTRAL_MAX_REPLY=512
MISTRAL_TEMPERATURE=0.1
MISTRAL_N_GPU_LAYERS=-1          # -1 = all layers on GPU, 0 = CPU only

GEMINI_MODEL=models/gemini-2.5-flash
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=4
MIN_CONFIDENCE_TO_FILTER=0.70
PARALLEL_WORKERS=5

# ── App ───────────────────────────────────────────────────────────────────────
GRADIO_PORT=7860
GRADIO_SHARE=false
GRADIO_DEBUG=false
CHAT_HISTORY_PATH=./chat_history.txt
